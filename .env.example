# ─────────────────────────────────────────────
#  CODEFORGE — Environment Configuration
#  Copy this file to .env and fill in your keys
#  .env is gitignored and never committed
# ─────────────────────────────────────────────

# Required ─────────────────────────────────────
# Groq API key — free at console.groq.com
GROQ_API_KEY=gsk_...

# Tavily Search key — free at app.tavily.com
TAVILY_API_KEY=tvly-...

# Optional: Model tuning ───────────────────────
MODEL_NAME=llama-3.3-70b-versatile
TEMPERATURE=0.1
MAX_CODE_ITERATIONS=3
MAX_DEBUG_ATTEMPTS=3

# Optional: LangSmith tracing ──────────────────
# Use a personal token (lsv2_pt_*) from smith.langchain.com
# Do NOT use a service key (lsv2_sk_*) — it won't work
LANGSMITH_API_KEY=lsv2_pt_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=CODEFORGE

# Optional: Flowise canvas builder ─────────────
FLOWISE_API_KEY=...
